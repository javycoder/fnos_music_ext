#!/bin/bash
# Restore the pre-upgrade data backup, then re-run the installer against the
# saved .env so the container and proxy unit come back up on the new files.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

[ -n "${FNMUSIC_REPO_DIR}" ] || fnmusic_fail "应用文件缺失（install.sh 不存在）"

BACKUP_DIR="${TRIM_PKGVAR:-/tmp}/upgrade-backup"
if [ -f "${BACKUP_DIR}/data.tar.gz" ]; then
    if ! ( cd "${BACKUP_DIR}" && tar -xzf data.tar.gz -C "${FNMUSIC_REPO_DIR}" ) >> "${FNMUSIC_LOG}" 2>&1; then
        fnmusic_fail "恢复用户数据失败：备份保留在 ${BACKUP_DIR}/data.tar.gz"
    fi
fi

# 升级流程已完整恢复历史 .env 与 sources-data 数据；
# 无需传递推导的 --sources 与单值 --lx-source-url，由 install.sh 自动从 .env
# 继承音源与完整多源列表；仅在洛雪源时透传 --lx-skip-verify 防止源临时故障卡死升级。
SOURCES="$(fnmusic_saved_source)"

ARGS=(--non-interactive --webui --extend --adopt)
if [ "${SOURCES}" = "lxmusic" ]; then
    ARGS+=(--lx-skip-verify)
fi

cd "${FNMUSIC_REPO_DIR}"
if ! fnmusic_run_logged bash ./install.sh "${ARGS[@]}"; then
    # 升级失败后应用中心回滚 target：repo 目录会被原地重建（inode 更换），运行中
    # 的容器仍绑着旧 inode（/repo 变空、healthcheck 持续失败且占用端口/容器名）。
    # 先移除让下次 start/升级重试干净重建，与 install_callback 失败路径对称。
    fnmusic_cleanup_sources_container
    # 升级失败弹窗要能看到真实错误行（回滚会带走 TRIM_PKGVAR 里的日志）
    fnmusic_fail_from_log "升级失败（数据备份保留在 ${BACKUP_DIR}）"
fi

rm -rf "${BACKUP_DIR}"

exit 0
