#!/bin/bash
# Restore the official music app first (socket, systemd unit, containers),
# then always archive user data to the storage volume root before removal
# (uninstall deletes the app directory; the archive is the user's escape hatch).
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

if [ -n "${FNMUSIC_REPO_DIR}" ] && [ -f "${FNMUSIC_REPO_DIR}/restore.sh" ]; then
    if ! bash "${FNMUSIC_REPO_DIR}/restore.sh" >> "${FNMUSIC_LOG}" 2>&1 \
       && ! bash "${FNMUSIC_REPO_DIR}/restore.sh" --adopt >> "${FNMUSIC_LOG}" 2>&1; then
        # 常规还原与 --adopt 均失败（如 unit 指向已删除的目录）时降级为无条件
        # 清理，保证卸载永远可以完成。官方 socket 由 unit 停止时的 ExecStopPost
        # 尽力恢复；若官方音乐异常，重装本扩展后再卸载一次即可修复。
        # FNMUSIC_UNIT_FILE 仅供测试注入；生产路径固定为 /etc/systemd/system。
        FNMUSIC_UNIT_FILE="${FNMUSIC_UNIT_FILE:-/etc/systemd/system/fnmusic-ext.service}"
        echo "[fnmusic-ext] 常规还原失败，降级为强制清理继续卸载" >> "${FNMUSIC_LOG}" 2>&1
        systemctl stop fnmusic-ext.service >> "${FNMUSIC_LOG}" 2>&1 || true
        systemctl disable fnmusic-ext.service >> "${FNMUSIC_LOG}" 2>&1 || true
        rm -f "${FNMUSIC_UNIT_FILE}"
        systemctl daemon-reload >> "${FNMUSIC_LOG}" 2>&1 || true
        docker rm -f fnmusic-sources >> "${FNMUSIC_LOG}" 2>&1 || true
    fi
fi

# 兼容旧的向导开关（历史版本安装时可能记录）：显式 false 才跳过备份
KEEP="${wizard_keep_data:-true}"
case "${KEEP}" in
    false|False|FALSE|0|no) exit 0 ;;
esac

if [ -z "${FNMUSIC_REPO_DIR}" ]; then
    exit 0
fi

ITEMS="$(fnmusic_data_items)"
[ -n "${ITEMS}" ] || exit 0

# target symlink looks like /vol{n}/@appcenter/fnmusic-ext
VOL="$(readlink -f "${FNMUSIC_APP_ROOT}/target" 2>/dev/null | sed -n 's#^\(/vol[0-9]\+/\).*#\1#p')"
# 解析失败时落到存储卷根目录。缺斜杠会变成 /vol1fnmusic-ext-backup-… 写到文件系统根上。
VOL="${VOL:-/vol1/}"
case "${VOL}" in
    */) ;;
    *) VOL="${VOL}/" ;;
esac
ARCHIVE="${VOL}fnmusic-ext-backup-$(date +%Y%m%d%H%M%S).tar.gz"
# shellcheck disable=SC2086
if ! tar -czf "${ARCHIVE}" -C "${FNMUSIC_REPO_DIR}" ${ITEMS} >> "${FNMUSIC_LOG}" 2>&1; then
    fnmusic_fail "备份数据到 ${ARCHIVE} 失败，已中止卸载（可重试或手动备份）"
fi
echo "[fnmusic-ext] 卸载前已备份配置与数据到 ${ARCHIVE}" >> "${FNMUSIC_LOG}"
echo "${ARCHIVE}"

exit 0
