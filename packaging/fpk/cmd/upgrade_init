#!/bin/bash
# fnOS replaces everything under target/ on upgrade; user data (.env, login
# state, favorites, history) lives inside the repo dir, so back it up first.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

systemctl stop fnmusic-ext.service >> "${FNMUSIC_LOG}" 2>&1 || true

# 迁卷/换目录自愈：unit 的 WorkingDirectory 与本次安装目录不一致时（应用迁到
# 其他卷、或此前从别的副本部署），升级回调里 install.sh 的归属检查会拒绝继续，
# 造成升级循环失败。升级流程必然重建 unit，这里直接清掉失效的旧 unit 文件。
# FNMUSIC_UNIT_FILE 仅供测试注入；生产路径固定为 /etc/systemd/system 下本服务 unit。
FNMUSIC_UNIT_FILE="${FNMUSIC_UNIT_FILE:-/etc/systemd/system/fnmusic-ext.service}"
if [ -n "${FNMUSIC_REPO_DIR}" ] && [ -f "${FNMUSIC_UNIT_FILE}" ]; then
    unit_wd="$(sed -n 's/^[[:space:]]*WorkingDirectory=//p' "${FNMUSIC_UNIT_FILE}" | head -n1)"
    unit_wd_real="$(readlink -f -- "${unit_wd}" 2>/dev/null || true)"
    repo_real="$(readlink -f -- "${FNMUSIC_REPO_DIR}" 2>/dev/null || true)"
    if [ -z "${unit_wd_real}" ] || [ "${unit_wd_real}" != "${repo_real}" ]; then
        rm -f "${FNMUSIC_UNIT_FILE}"
        systemctl daemon-reload >> "${FNMUSIC_LOG}" 2>&1 || true
        echo "[fnmusic-ext] 已清理指向 ${unit_wd:-未知路径} 的失效代理 unit（升级流程会重建）" >> "${FNMUSIC_LOG}" 2>&1
    fi
fi

# 迁卷/换目录容器自愈：如果存在 fnmusic-sources 容器且归属于旧卷/其他目录，提前清理
if command -v docker >/dev/null 2>&1 && docker container inspect fnmusic-sources >/dev/null 2>&1; then
    cnt_wd="$(docker container inspect fnmusic-sources --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' 2>/dev/null || true)"
    cnt_wd_real="$(readlink -f -- "${cnt_wd}" 2>/dev/null || true)"
    repo_real="$(readlink -f -- "${FNMUSIC_REPO_DIR}" 2>/dev/null || true)"
    if [ -n "${cnt_wd_real}" ] && [ "${cnt_wd_real}" != "${repo_real}" ]; then
        docker rm -f fnmusic-sources >> "${FNMUSIC_LOG}" 2>&1 || true
        echo "[fnmusic-ext] 已清理属于旧目录 ${cnt_wd} 的 fnmusic-sources 容器（升级流程会重建）" >> "${FNMUSIC_LOG}" 2>&1
    fi
fi

if [ -z "${FNMUSIC_REPO_DIR}" ]; then
    exit 0
fi

BACKUP_DIR="${TRIM_PKGVAR:-/tmp}/upgrade-backup"
rm -rf "${BACKUP_DIR}"
mkdir -p "${BACKUP_DIR}"

ITEMS="$(fnmusic_data_items)"
if [ -n "${ITEMS}" ]; then
    # --ignore-failed-read：播放历史/缓存文件在打包读取中途消失（服务仍在写）时
    # 不再让整个升级中止，缺失项仅记录 warning。
    # shellcheck disable=SC2086
    if ! tar --ignore-failed-read -czf "${BACKUP_DIR}/data.tar.gz" -C "${FNMUSIC_REPO_DIR}" ${ITEMS} >> "${FNMUSIC_LOG}" 2>&1; then
        rm -rf "${BACKUP_DIR}"
        fnmusic_fail "升级前备份数据失败，已中止（未改动任何数据）"
    fi
fi

exit 0
