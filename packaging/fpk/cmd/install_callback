#!/bin/bash
# Run the repo installer with the wizard answers (wizard_* env vars).
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

[ -n "${FNMUSIC_REPO_DIR}" ] || fnmusic_fail "应用文件缺失（install.sh 不存在）"

SOURCES="${wizard_sources:-}"
case "${SOURCES}" in
    musicdl|musicbox|lxmusic) ;;
    *) SOURCES="musicdl" ;;
esac

EXTEND="${wizard_extend:-true}"
case "${EXTEND}" in
    true|True|TRUE|1|yes) EXTEND=1 ;;
    *) EXTEND=0 ;;
esac

ARGS=(--non-interactive --sources "${SOURCES}" --webui)
# 洛雪源脚本（URL/电脑上传/NAS 选择）统一装好后在管理页 WebUI 配置：
# 安装向导平台没有文件上传组件，URL 也不再向安装者索要，无源安装不阻塞。
if [ -n "${wizard_lx_url:-}" ]; then
    # 兼容旧版向导写入的向导值（升级场景等）：有值就透传，无值不要求
    ARGS+=(--lx-source-url "${wizard_lx_url}")
fi
[ "${EXTEND}" -eq 1 ] && ARGS+=(--extend)

cd "${FNMUSIC_REPO_DIR}"
if ! fnmusic_run_logged bash ./install.sh "${ARGS[@]}"; then
    # 安装失败后应用中心会回滚删除 TRIM_PKGVAR（fnmusic-app.log 随之消失）。
    # 过程输出已在 FNMUSIC_DURABLE_LOG，弹窗带上该路径和错误行。
    # 回滚不删 compose 容器，这里先清掉，避免空挂载孤儿占名。
    fnmusic_cleanup_sources_container
    fnmusic_fail_from_log "安装失败"
fi

exit 0
