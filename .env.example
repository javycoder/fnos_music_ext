# Copy this file to .env and fill in values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

FNMUSIC_HOME=

# Sources: enable at least one (install.sh --sources musicdl,musicbox)
# musicdl: https://github.com/CharlesPikachu/musicdl
# musicbox: https://github.com/darknessomi/musicbox
FNMUSIC_MUSICDL_ENABLED=true
FNMUSIC_NETEASE_ENABLED=true
FNMUSIC_MUSICDL_URL=http://127.0.0.1:8768
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
FNMUSIC_ONLINE_SOURCES=MiguMusicClient,KuwoMusicClient

# Daily recommend (OpenAI-compatible). Leave empty to disable.
FNMUSIC_LLM_BASE_URL=
FNMUSIC_LLM_API_KEY=
FNMUSIC_LLM_MODEL=gpt-4o-mini
